                'bk_username': TS['bk_user']['bk_username'],
            }
        )
        result = client.bk_login.get_user()
        self.assertTrue(result['result'], json.dumps(result))
        self.assertTrue(result['data']['bk_username'], TS['bk_user']['bk_username'])

    def test_api_post(self):
